# GitHub Activity Monitor Environment Variables
# Copy this file to .env and fill in your values for local testing
# NOTE: .env is ignored by git and should never be committed

# GitHub Personal Access Token (required)
GH_TOKEN=your_github_personal_access_token_here

# Slack Bot User OAuth Token (required, starts with xoxb-)
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Slack Channel ID where messages should be posted (required)
SLACK_CHANNEL=C12345678

# Optional: Organization to monitor (if omitted, monitors the user's repositories)
TARGET_ORG=my-company-org

# Optional: Number of days to look back for activity (defaults to 1)
DAYS_BACK=1